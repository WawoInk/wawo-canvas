{
    auto_https off
}

:80 {

    encode zstd gzip

    handle /api/* {
        reverse_proxy api:8088
    }

    handle {
        root * /usr/share/nginx/html
        route {
            try_files {path} /index.html
            header /index.html Cache-Control "no-store"
            header /build-version.txt Cache-Control "no-store"
            file_server
        }
    }
}
